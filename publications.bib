@article{Edri2014,
	title = {Chloride inclusion and hole transport material doping to improve methyl ammonium lead bromide perovskite-based high open-circuit voltage solar cells},
	volume = {5},
	abstract = {Low-cost solar cells with high VOC, relatively small (EG - qVOC), and high qVOC/EG ratio, where EG is the absorber band gap, are long sought after, especially for use in tandem cells or other systems with spectral splitting. We report a significant improvement in CH3NH3PbBr3-based cells, using CH3NH3PbBr3-xClx, with EG = 2.3 eV, as the absorber in a mesoporous p-i-n device configuration. By p-doping an organic hole transport material with a deep HOMO level and wide band gap to reduce recombination, the cell's VOC increased to 1.5 V, a 0.2 V increase from our earlier results with the pristine Br analogue with an identical band gap. At the same time, in the most efficient devices, the current density increased from ∼1 to ∼4 mA/cm(2).},
	number = {3},
	journal = {The journal of physical chemistry letters},
	author = {Edri, E and Kirmayer, S and Kulbak, M and Hodes, G and Cahen, D},
