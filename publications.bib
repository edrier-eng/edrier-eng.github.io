	month = sep,
	year = {2022},
	pages = {1--11},
	file = {PDF:/Users/eranedri/Zotero/storage/ZNTPHYH5/Zimmermann et al. - 2022 - Controlled Crystallinity of TiO2 Layers Grown by Atmospheric Pressure Spatial Atomic Layer Depositio.pdf:application/pdf},
}

