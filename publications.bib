	file = {McKenzie et al. - 2022 - Versatile Tools for Understanding Electrosynthetic Mechanisms.pdf:/Users/eranedri/Zotero/storage/YWJGJFYG/McKenzie et al. - 2022 - Versatile Tools for Understanding Electrosynthetic Mechanisms.pdf:application/pdf},
