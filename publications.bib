	volume = {28},
	issn = {0887-0624, 1520-5029},
	url = {https://pubs.acs.org/doi/10.1021/ef501802r},
	doi = {10.1021/ef501802r},
	abstract = {To make hydrogen a feasible energy carrier, its transformation into another chemical is advisible. Formic acid may constitute an attractive option to store hydrogen in a dense and safe form. The eﬃciency of formic-acid-based process chains for the storage of hydrogen energy has been evaluated. The eﬃciency is highly dependent upon the way formic acid is produced. Options based on reactions of hydrogen with carbon dioxide show a rather poor energetic performance, while routes using renewable production of intermediate carbon monoxide can reach competitive eﬃciencies. For the storage of electrical energy, an overall eﬃciency of about 12\% is possible using the current state of the art technology, but alternative processes show potential for higher eﬃciencies.},
	language = {en},
	number = {10},
