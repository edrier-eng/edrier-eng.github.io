	pages = {6221--6228},
	file = {Sandnes et al. - 2007 - Electrodeposition of bismuth from nitric acid electrolyte.pdf:/Users/eranedri/Zotero/storage/J7GZJ8TJ/Sandnes et al. - 2007 - Electrodeposition of bismuth from nitric acid electrolyte.pdf:application/pdf},
}

@article{Jiang2003,
