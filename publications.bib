	file = {An et al. - 2024 - Metavalently bonded tellurides the essence of improved thermoelectric performance in elemental Te:/Users/eranedri/Zotero/storage/J2F9TB47/An et al. - 2024 - Metavalently bonded tellurides the essence of improved thermoelectric performance in elemental Te.pdf:application/pdf;An et al. - 2024 - Metavalently bonded tellurides the essence of improved thermoelectric performance in elemental Te.pdf:/Users/eranedri/Zotero/storage/WWCHE6X9/An et al. - 2024 - Metavalently bonded tellurides the essence of improved thermoelectric performance in elemental Te.pdf:application/pdf},
