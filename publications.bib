	issn = {2639-4979, 2639-4979},
	url = {https://pubs.acs.org/doi/10.1021/acsmaterialslett.6c00305},
	doi = {10.1021/acsmaterialslett.6c00305},
	abstract = {Dynamic interfacial reconstruction can fundamentally reshape the catalytic pathway of CO2 electroreduction, yet how it regulates H2O participation on Sn-based catalysts remains unclear. Here we report a precursor SnS2/SnO2 heterostructure that evolves operando into an active Sn2S3/SnO2 heterojunction during CO2 electroreduction. The reconstructed catalyst achieves a formate Faradaic efficiency of 90.9\% with a formate partial current density of 35.2 mA·cm−2 at −1.0 V vs RHE and maintains FEformate above 85\% for 70 h. In situ Raman spectroscopy reveals the formation of the active Sn2S3/ SnO2 interface under the working conditions. In situ attenuated total reflectance surface-enhanced infrared absorption spectroscopy identifies enhanced *OCHO formation and distinct interfacial H2O restructuring of the evolved heterojunction. Microkinetic analysis indicates that the S-containing interface accelerates H2O dissociation, improves the hydrogen supply for proton-coupled *OCHO formation, and thereby drives selective CO2-to-formate conversion. This work highlights operando heterojunction evolution as an effective strategy to couple H2O activation with selective CO2 hydrogenation.},
	language = {en},
	urldate = {2026-04-28},
	journal = {ACS Materials Letters},
	author = {Li, Jinrong and Zhang, Wenwen and Tao, Ying and Ding, Jie and Yuan, Mingyuan and Liu, Lingyue and Mao, Qing},
	month = apr,
	year = {2026},
	pages = {acsmaterialslett.6c00305},
	file = {PDF:/Users/eranedri/Zotero/storage/K8BMZPSU/Li et al. - 2026 - Operando -Evolved Sn2 S3 SnO2 Heterojunction Promotes COsu.pdf:application/pdf},
}

@article{Liu2026CuDualAtomicCatalyst,
	title = {A {Cu}–{La} {Dual}‐{Atomic} {Catalyst} {With} {Dual}‐{Site} {Adsorption} {Enables} {Synergistic} {Optimization} of {Thermodynamics} and {Kinetics} of {Electrocatalytic} {CO}$_{\textrm{2}}$ {Reduction}},
	issn = {1433-7851, 1521-3773},
	url = {https://onlinelibrary.wiley.com/doi/10.1002/anie.202521626},
	doi = {10.1002/anie.202521626},
	abstract = {Single-atomic catalysts face the following major challenges in the rapidly advancing field of electrocatalytic CO2 reduction (ECR) to CO: linear scaling relationships between adsorption strengths of intermediates lead to unfavored ECR thermodynamics; low CO2/proton/electron concentrations within microenvironments on catalyst surfaces limit ECR kinetics. Consequently, we synthesized a Cu–La dual-atomic catalyst (DAC) for synergistically optimizing the ECR thermodynamics and kinetics. The Cu and La sites of Cu–La DAC can respectively couple the C and O atoms of *COOH, forming a novel dual-site *COOH adsorption configuration, which does not undergo a transition to subsequent *CO. Cu–La DAC can effectively break the linear scaling relationship and optimize the ECR thermodynamics. Furthermore, Cu and La, possessing distinct conductivity, hydrophilicity, and CO2 adsorption capabilities, collectively modulate the microenvironments on the surface of Cu–La DAC. This facilitates the efficient supply of electrons, protons, and CO2 for ECR, thereby greatly enhancing the kinetics. This work combines Cu and La, which have different macroscopic properties and electronic structures (microscopic), to synergistically optimize thermodynamics and kinetics based on the dual-site adsorption of DAC, providing new insights for designing high-performance catalysts and discovering efficient mechanisms.},
	language = {en},
	urldate = {2026-04-28},
	journal = {Angewandte Chemie International Edition},
	author = {Liu, Weiqi and Wang, Haoquan and Xu, Shiyong and Wei, Shilin and Bai, Peiyao and Zhu, Chang and Xu, Lang},
	month = apr,
	year = {2026},
	pages = {e21626},
	file = {PDF:/Users/eranedri/Zotero/storage/8I33HXHV/Liu et al. - 2026 - A Cu–La Dual‐Atomic Catalyst With Dual‐Site Adsorption Enables Synergistic Optimization of Thermodyn.pdf:application/pdf},
}

