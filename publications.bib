@article{Zhu2023,
	title = {Integration of {MnO}$_{\textrm{2}}$ {Nanosheets} with {Pd} {Nanoparticles} for {Efficient} {CO}$_{\textrm{2}}$ {Electroreduction} to {Methanol} in {Membrane} {Electrode} {Assembly} {Electrolyzers}},
