	journal = {The Journal of Physical Chemistry Letters},
	author = {Han, Yadong and Yu, Junhong and Zhang, Hang and Xu, Fang and Peng, Kunlin and Zhou, Xiaoyuan and Qiao, Liang and Misochko, Oleg V. and Nakamura, Kazutaka G. and Vanacore, Giovanni M. and Hu, Jianbo},
