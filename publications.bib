}

@article{Rijal2021b,
	title = {Influence of {Post}-selenization {Temperature} on the {Performance} of {Substrate}-{Type} {Sb}$_{\textrm{2}}$ {Se}$_{\textrm{3}}$ {Solar} {Cells}},
