@article{Cahen,
	title = {{FREE} {ENERGIES} {AND} {ENTHALPIES} {OF} {POSSIBLE} {GAS} {PHASE} {AND} {SURFACE} {REACTIONS} {FOR} {PREPARATION} {OF} {CuInSe},t},
	abstract = {Ah\&act--On the basis of literature data of thermodynamic quantities and functions for species that can be involved in the preparation of thin films of CuInSe,, we calculate free energies for a number of possible reactions. The reactions that are considered are especially relevant for the three-source vacuum evaporation process and for selenization of CuIn alloys. Reactions of species that can be present in the gas phase, with oxygen, are also considered. Where possible, free energies of reaction are calculated at temperatures relevant for these preparation processes. In some cases, only enthalpies of reaction could be given. We include a compilation of free energies and enthalpies of formation for I-III-VI, compounds and related binary chalcogenides. This can help future calculations of the type presented here for other I-III-VI, compounds.},
	language = {en},
