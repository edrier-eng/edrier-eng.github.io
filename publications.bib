@article{Abdinejad2025SolarDrivenCarbonDioxide,
	title = {Solar-{Driven} {Carbon} {Dioxide} {Capture} {Using} a {Photoelectrochemical} {Redox} {Flow} {System}},
	volume = {10},
	copyright = {https://doi.org/10.15223/policy-029},
