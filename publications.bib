	number = {40},
	urldate = {2026-03-06},
	journal = {The Journal of Physical Chemistry Letters},
	author = {Sun, Kaiwen and Ma, Hong and Xia, Wei and Suo, Peng and Zhang, Wenjie and Zou, Yuqing and Lin, Xian and Zhang, Saifeng and Guo, Yanfeng and Ma, Guohong},
	month = oct,
