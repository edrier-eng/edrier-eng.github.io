	file = {Sordakis et al. - 2016 - Carbon Dioxide to Methanol The Aqueous Catalytic Way at Room Temperature.pdf:/Users/eranedri/Zotero/storage/2DH2C2E9/Sordakis et al. - 2016 - Carbon Dioxide to Methanol The Aqueous Catalytic Way at Room Temperature.pdf:application/pdf},
}

