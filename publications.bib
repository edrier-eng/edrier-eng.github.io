	file = {Sun et al. - 2022 - Dynamical Response of Nonlinear Optical Anisotropy in a Tin Sulfide Crystal under Ultrafast Photoexc.pdf:/Users/eranedri/Zotero/storage/8XNVFTZ8/Sun et al. - 2022 - Dynamical Response of Nonlinear Optical Anisotropy in a Tin Sulfide Crystal under Ultrafast Photoexc.pdf:application/pdf},
}

