@article{Wuttig2023,
	title = {Revisiting the {Nature} of {Chemical} {Bonding} in {Chalcogenides} to {Explain} and {Design} their {Properties}},
	volume = {35},
	issn = {0935-9648, 1521-4095},
	url = {https://advanced.onlinelibrary.wiley.com/doi/10.1002/adma.202208485},
	doi = {10.1002/adma.202208485},
	abstract = {Abstract
            Quantum chemical bonding descriptors have recently been utilized to design materials with tailored properties. Their usage to facilitate a quantitative description of bonding in chalcogenides as well as the transition between different bonding mechanisms is reviewed. More importantly, these descriptors can also be employed as property predictors for several important material characteristics, including optical and transport properties. Hence, these quantum chemical bonding descriptors can be utilized to tailor material properties of chalcogenides relevant for thermoelectrics, photovoltaics, and phase‐change memories. Relating material properties to bonding mechanisms also shows that there is a class of materials, which are characterized by unconventional properties such as a pronounced anharmonicity, a large chemical bond polarizability, and strong optical absorption. This unusual property portfolio is attributed to a novel bonding mechanism, fundamentally different from ionic, metallic, and covalent bonding, which is called “metavalent.” In the concluding section, a number of promising research directions are sketched, which explore the nature of the property changes upon changing bonding mechanism and extend the concept of quantum chemical property predictors to more complex compounds.},
	language = {en},
	number = {20},
	urldate = {2026-03-06},
	journal = {Advanced Materials},
	author = {Wuttig, Matthias and Schön, Carl‐Friedrich and Lötfering, Jakob and Golub, Pavlo and Gatti, Carlo and Raty, Jean‐Yves},
	month = may,
	year = {2023},
	pages = {2208485},
	file = {Wuttig et al. - 2023 - Revisiting the Nature of Chemical Bonding in Chalcogenides to Explain and Design their Properties:/Users/eranedri/Zotero/storage/YM5RFXX2/Wuttig et al. - 2023 - Revisiting the Nature of Chemical Bonding in Chalcogenides to Explain and Design their Properties.pdf:application/pdf;Wuttig et al. - 2023 - Revisiting the Nature of Chemical Bonding in Chalcogenides to Explain and Design their Properties.pdf:/Users/eranedri/Zotero/storage/CXNKJTQ3/Wuttig et al. - 2023 - Revisiting the Nature of Chemical Bonding in Chalcogenides to Explain and Design their Properties.pdf:application/pdf},
}

@article{Wuttig2022,
	title = {Halide {Perovskites}: {Advanced} {Photovoltaic} {Materials} {Empowered} by a {Unique} {Bonding} {Mechanism}},
	volume = {32},
	issn = {1616-301X, 1616-3028},
	shorttitle = {Halide {Perovskites}},
	url = {https://advanced.onlinelibrary.wiley.com/doi/10.1002/adfm.202110166},
	doi = {10.1002/adfm.202110166},
	abstract = {Abstract
            
              Outstanding photovoltaic (PV) materials combine a set of advantageous properties including large optical absorption and high charge carrier mobility, facilitated by small effective masses. Halide perovskites (ABX
              3
              , where X = I, Br, or Cl) are among the most promising PV materials. Their optoelectronic properties are governed by the BX bond, which is responsible for the pronounced optical absorption and the small effective masses of the charge carriers. These properties are frequently attributed to the
              n
              s
              2
              configuration of the B atom, i.e., Pb 6s
              2
              or Sn 5s
              2
              (“lone‐pair”) states. The analysis of the PV properties in conjunction with a quantum‐chemical bond analysis reveals a different scenario. The BX bond differs significantly from ionic, metallic, or conventional 2c2e covalent bonds. Instead it is better regarded as metavalent, since it shares about one p‐electron between adjacent atoms. The resulting σ‐bond, formally a 2c1e bond, is half‐filled, causing pronounced optical absorption. Electron transfer between B and X atoms and lattice distortions open a moderate bandgap resulting in charge carriers with small effective masses. Hence, metavalent bonding explains favorable PV properties of halide perovskites, as summarized in a map for different bond types, which provides a blueprint to design PV materials.},
	language = {en},
