@article{Renfrew2020,
	title = {Electrochemical {Approaches} toward {CO}$_{\textrm{2}}$ {Capture} and {Concentration}},
	volume = {10},
	copyright = {https://doi.org/10.15223/policy-029},
	issn = {2155-5435, 2155-5435},
	url = {https://pubs.acs.org/doi/10.1021/acscatal.0c03639},
	doi = {10.1021/acscatal.0c03639},
	abstract = {Carbon capture and concentration of low partial pressure CO2 in air and ﬂue gas is a key step in carbon abatement strategies. Traditional CO2 capture methods employ temperature or pressure swings; however, electrochemical swings, in which an applied potential modulates nucleophilicity, are also possible to mediate the capture and release of CO2. In contrast to the breadth of electrochemical CO2 reduction research, electrochemically mediated CO2 capture and concentration is an emerging ﬁeld. Although some aspects are reminiscent of those in CO2 reduction, like local pH gradients and (bi)carbonate equilibria, ultimately electrochemical CO2 capture and concentration poses its own unique challenges that will beneﬁt from insights from intercalative batteries, redox ﬂow batteries, and biomimetic/-inspired design, among other ﬁelds. After an introduction to carbon capture and current chemical strategies, this Review highlights promising emerging electrochemical methods to enable CO2 capture and concentration; speciﬁcally discussed are organic redox, transition metal redox, and pH swings. It closes with an outlook and discussion of future research challenges for electrochemically mediated capture.},
	language = {en},
	number = {21},
	urldate = {2026-03-06},
	journal = {ACS Catalysis},
	author = {Renfrew, Sara E. and Starr, David E. and Strasser, Peter},
	month = nov,
	year = {2020},
	pages = {13058--13074},
	file = {PDF:/Users/eranedri/Zotero/storage/K58JZFKK/Renfrew et al. - 2020 - Electrochemical Approaches toward CO2 Capture and Concentration.pdf:application/pdf},
}

@article{Sabatino2020,
	title = {Evaluation of a {Direct} {Air} {Capture} {Process} {Combining} {Wet} {Scrubbing} and {Bipolar} {Membrane} {Electrodialysis}},
	volume = {59},
	copyright = {http://pubs.acs.org/page/policy/authorchoice\_ccbyncnd\_termsofuse.html},
	issn = {0888-5885, 1520-5045},
	url = {https://pubs.acs.org/doi/10.1021/acs.iecr.9b05641},
	doi = {10.1021/acs.iecr.9b05641},
	abstract = {A detailed techno-economic analysis of a novel direct air capture (DAC) process has been carried out. In this process, carbon dioxide is separated from ambient air through wet scrubbing with an aqueous potassium hydroxide solution, while the solvent regeneration and CO2 recovery is carried out through bipolar membrane electrodialysis (BPMED), a novel process exclusively based on electrical-driven regeneration. The results of the techno-economic analysis showed that the regeneration process could be less energy intensive than other solutions, requiring as low as 236 kJ/mol-CO2. However, the high costs of bipolar and ion exchange membranes make the BPMED expensive. In the base-case scenario, the total capture cost has been found to be 773 \$/tonCO2, in line with previous cost estimates for DAC but large for a second generation process. As for other DAC processes, this solution could become particularly interesting in the future, whenever cheaper renewable energy and more aﬀordable and improved membranes become available.},
	language = {en},
	number = {15},
	urldate = {2026-03-06},
	journal = {Industrial \& Engineering Chemistry Research},
	author = {Sabatino, Francesco and Mehta, Mayank and Grimm, Alexa and Gazzani, Matteo and Gallucci, Fausto and Kramer, Gert Jan and Van Sint Annaland, Martin},
	month = apr,
	year = {2020},
	pages = {7007--7020},
	file = {PDF:/Users/eranedri/Zotero/storage/D6KQS2AP/Sabatino et al. - 2020 - Evaluation of a Direct Air Capture Process Combining Wet Scrubbing and Bipolar Membrane Electrodialy.pdf:application/pdf},
}

@article{Sandford2019,
	title = {A synthetic chemist's guide to electroanalytical tools for studying reaction mechanisms},
	volume = {10},
	issn = {2041-6520, 2041-6539},
	url = {https://xlink.rsc.org/?DOI=C9SC01545K},
	doi = {10.1039/C9SC01545K},
	abstract = {A range of electroanalytical tools can be applied to studying redox reactions, probing key mechanistic questions in synthetic chemistry.
          , 
            
              Monitoring reactive intermediates can provide vital information in the study of synthetic reaction mechanisms, enabling the design of new catalysts and methods. Many synthetic transformations are centred on the alteration of oxidation states, but these redox processes frequently pass through intermediates with short life-times, making their study challenging. A variety of electroanalytical tools can be utilised to investigate these redox-active intermediates: from voltammetry to
              in situ
              spectroelectrochemistry and scanning electrochemical microscopy. This perspective provides an overview of these tools, with examples of both electrochemically-initiated processes and monitoring redox-active intermediates formed chemically in solution. The article is designed to introduce synthetic organic and organometallic chemists to electroanalytical techniques and their use in probing key mechanistic questions.},
	language = {en},
	number = {26},
