@article{Rahman2016a,
	title = {Distinctive {Extrinsic} {Atom} {Effects} on the {Structural}, {Optical}, and {Electronic} {Properties} of {Bi}$_{\textrm{2}}$ {S}$_{\textrm{3-x}}$ {Se}$_{\textrm{ \textit{x} }}$ {Solid} {Solutions}},
