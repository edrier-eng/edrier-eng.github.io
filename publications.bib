	url = {https://pubs.acs.org/doi/10.1021/acsaem.1c00657},
	doi = {10.1021/acsaem.1c00657},
	abstract = {Antimony selenide (Sb2Se3) solar cells are an environmentally friendly and cost-eﬀective photovoltaic technology. In this work, we fabricate Sb2Se3 solar cells using closed-space sublimation followed by postdeposition selenization. We investigate the eﬀects of the selenization temperature on the structural and morphological properties of Sb2Se3 ﬁlms and photovoltaic performance of the corresponding devices. The results indicate that a proper selenization temperature is critical to achieving Sb2Se3 ﬁlms with large grains, uniform morphology, high crystallinity, desired crystal orientations, and increased carrier density. By optimizing the selenization temperature, we obtained Sb2Se3 solar cells with a power-conversion eﬃciency of 6.43\%.},
