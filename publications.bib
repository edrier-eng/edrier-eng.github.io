	journal = {Advanced Energy Materials},
	author = {Andrei, Virgil and Hoye, Robert L. Z. and Crespo‐Quesada, Micaela and Bajada, Mark and Ahmad, Shahab and De Volder, Michael and Friend, Richard and Reisner, Erwin},
	month = sep,
	year = {2018},
	pages = {1801403},
	file = {Andrei et al. - 2018 - Scalable Triple Cation Mixed Halide Perovskite–BiVO4 Tandems for Bias‐Free Water Splittin.pdf:/Users/eranedri/Zotero/storage/9FM6YK5E/Andrei et al. - 2018 - Scalable Triple Cation Mixed Halide Perovskite–BiVO4 Tandems for Bias‐Free Water Splittin.pdf:application/pdf},
}

@article{Awais2022,
