@article{Seo2021,
	title = {Amorphous {TiO}$_{\textrm{2}}$ {Coatings} {Stabilize} {Perovskite} {Solar} {Cells}},
	volume = {6},
	copyright = {https://creativecommons.org/licenses/by-nc-nd/4.0/},
	issn = {2380-8195, 2380-8195},
	url = {https://pubs.acs.org/doi/10.1021/acsenergylett.1c01446},
	doi = {10.1021/acsenergylett.1c01446},
	abstract = {Signiﬁcant progress has been achieved in improving the power conversion eﬃciency (PCE) of perovskite solar cells (PSCs) for a decade, but the long-term stability is still underdeveloped. In a regular PSC structure, 2,2′,7,7′-tetrakis(N,N-di-p-methoxyphenylamine)9,9′-spirobiﬂuorene (SpiroOMeTAD) with Li additives and metal electrodes are widely adopted, which leads to facile degradation under device operating conditions because of ion migration. Herein, we show an interface-engineered stabilization approach to prevent ion migration in PSCs enabled by amorphous (a)-TiO2 capable of hole transfer grown by atomic layer deposition (ALD). This layer prevents ion migration of Li additives with consequent aggregation as well as metal electrode diﬀusion into the perovskite layer. Furthermore, the combined layers of Spiro-OMeTAD/a-TiO2 unprecedentedly promote device eﬃciency, which is further veriﬁed with other organic hole transport layers. Finally, the operational stability of the TiO2-PSC is substantially improved in comparison to that of the control PSC.},
	language = {en},
	number = {9},
	urldate = {2026-03-06},
	journal = {ACS Energy Letters},
	author = {Seo, Seongrok and Shin, Sooeun and Kim, Eunsoo and Jeong, Seonghwa and Park, Nam-Gyu and Shin, Hyunjung},
	month = sep,
	year = {2021},
	pages = {3332--3341},
	file = {Seo et al. - 2021 - Amorphous TiO2 Coatings Stabilize Perovskite Solar Cells.pdf:/Users/eranedri/Zotero/storage/6YRAANRR/Seo et al. - 2021 - Amorphous TiO2 Coatings Stabilize Perovskite Solar Cells.pdf:application/pdf},
}

@article{Shih2025,
	title = {A {2D}/{3D} {Heterostructure} {Perovskite} {Solar} {Cell} with a {Phase}‐{Pure} and {Pristine} {2D} {Layer}},
	volume = {37},
	issn = {0935-9648, 1521-4095},
	url = {https://advanced.onlinelibrary.wiley.com/doi/10.1002/adma.202416672},
	doi = {10.1002/adma.202416672},
	abstract = {Abstract
            
              Interface engineering plays a critical role in advancing the performance of perovskite solar cells. As such, 2D/3D perovskite heterostructures are of particular interest due to their optoelectrical properties and their further potential improvements. However, for conventional solution‐processed 2D perovskites grown on an underlying 3D perovskite, the reaction stoichiometry is normally unbalanced with excess precursors. Moreover, the formed 2D perovskite is impure, leading to unfavorable energy band alignment at the interface. Here a simple method is presented that solves both issues simultaneously. The 2D formation reaction is taken first to completion, fully consuming excess PbI
              2
              . Then, isopropanol is utilized to remove excess organic ligands, control the 2D perovskite thickness, and obtain a phase‐pure,
              n
              = 2, 2D perovskite. The outcome is a pristine (without residual 2D precursors) and phase‐pure 2D perovskite heterostructure with improved surface passivation and charge carrier extraction compared to the conventional solution process. PSCs incorporating this treatment demonstrate a notable improvement in both stability and power conversion efficiency, with negligible hysteresis, compared to the conventional process.},
