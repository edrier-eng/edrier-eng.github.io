	doi = {10.1016/j.isci.2022.105153},
	abstract = {Carbon capture from both stationary emitters and dilute sources is critically needed to mitigate climate change. Carbon dioxide separation methods driven by electrochemical stimuli show promise to sidestep the high-energy penalty and fossil-fuel dependency associated with the conventional pressure and temperature swings. Compared with a batch process, electrochemically mediated carbon capture (EMCC) operating in a continuous ﬂow mode offers greater design ﬂexibility. Therefore, this review introduces key advances in continuous ﬂow EMCC for point source, air, and ocean carbon captures. Notably, the main challenges and future research opportunities for practical implementation of continuous ﬂow EMCC processes are discussed from a multi-scale perspective, from molecules to electrochemical cells and ﬁnally to separation systems.},
