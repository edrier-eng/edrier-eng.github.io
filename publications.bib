}

@article{Lin2023NanocompositeBismuthClusters,
	title = {A {Nanocomposite} of {Bismuth} {Clusters} and {Bi}$_{\textrm{2}}$ {O}$_{\textrm{2}}$ {CO}$_{\textrm{3}}$ {Sheets} for {Highly} {Efficient} {Electrocatalytic} {Reduction} of {CO}$_{\textrm{2}}$ to {Formate}},
