	url = {https://chemistry-europe.onlinelibrary.wiley.com/doi/10.1002/chem.201603407},
	doi = {10.1002/chem.201603407},
	abstract = {Carbon dioxide may constitute a source of chemicals and fuels if efficient and renewable processes are developed that directly utilize it as feedstock. Two of its reduction products are formic acid and methanol, which have also been proposed as liquid organic chemical carriers in sustainable hydrogen storage. Here we report that both the hydrogenation of carbon dioxide to formic acid and the disproportionation of formic acid into methanol can be realized at ambient temperature and in aqueous, acidic solution, with an iridium catalyst. The formic acid yield is maximized in water without additives, while acidification results in complete (98 \%) and selective (96 \%) formic acid disproportionation into methanol. These promising features in combination with the low reaction temperatures and the absence of organic solvents and additives are relevant for a sustainable hydrogen/methanol economy.},
	language = {en},
	number = {44},
