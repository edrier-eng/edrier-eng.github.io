	journal = {Energy \& Environmental Science},
	author = {Burdyny, Thomas and Smith, Wilson A.},
	year = {2019},
	pages = {1442--1453},
	file = {Burdyny and Smith - 2019 - CO2 reduction on gas-diffusion electrodes and why catalytic performance must be assessed.pdf:/Users/eranedri/Zotero/storage/EBTU2X5F/Burdyny and Smith - 2019 - CO2 reduction on gas-diffusion electrodes and why catalytic performance must be assessed.pdf:application/pdf},
}

