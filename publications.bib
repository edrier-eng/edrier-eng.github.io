	file = {Ryu et al. - 2018 - Quantification of Interfacial pH Variation at Molecular Length Scales Using a Concurrent Non‐Faradai.pdf:/Users/eranedri/Zotero/storage/SNBP4PYH/Ryu et al. - 2018 - Quantification of Interfacial pH Variation at Molecular Length Scales Using a Concurrent Non‐Faradai.pdf:application/pdf},
}

@article{Hessler2021,
	title = {{In3SbTe2} as a programmable nanophotonics material platform for the infrared},
	volume = {12},
	issn = {2041-1723},
