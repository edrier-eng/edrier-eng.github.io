	number = {17},
	urldate = {2026-03-06},
	journal = {Advanced Materials},
	author = {Shih, Meng‐Chen and Tan, Shaun and Lu, Yongli and Kodalle, Tim and Lee, Do‐Kyoung and Dong, Yifan and Larson, Bryon W. and Park, Soyeon and Zhang, Ruiqi and Grotevent, Matthias J. and Sverko, Tara and Zhu, Hua and Lin, Yu‐Kuan and Sutter‐Fella, Carolin M. and Zhu, Kai and Beard, Matthew C. and Bulović, Vladimir and Bawendi, Moungi G.},
	month = apr,
	year = {2025},
	pages = {2416672},
	file = {Shih et al. - 2025 - A 2D3D Heterostructure Perovskite Solar Cell with a Phase‐Pure and Pristine 2D Layer.pdf:/Users/eranedri/Zotero/storage/CXKNHM92/Shih et al. - 2025 - A 2D3D Heterostructure Perovskite Solar Cell with a Phase‐Pure and Pristine 2D Layer.pdf:application/pdf},
